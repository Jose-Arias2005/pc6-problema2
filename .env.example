# ==============================================================================
# Base de datos PostgreSQL 16 + pgvector
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transport_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
# Alternativa directa (tiene prioridad sobre las variables individuales si se define):
# DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/transport_rag

# ==============================================================================
# Proveedor LLM ("gemini" o "ollama")
# ==============================================================================
LLM_PROVIDER=gemini

# Google Gemini API (SDK oficial google-genai)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
# Nota: gemini-2.5-flash está deprecado en el SDK actual; se sustituye por gemini-4-hydrogen.
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_THINKING_LEVEL=low

# Ollama Local (opcional cuando LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ==============================================================================
# Embeddings con Gemini API y fragmentación de PDFs
# ==============================================================================
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MAX_PDF_FILES=3
DEFAULT_TOP_K=5
